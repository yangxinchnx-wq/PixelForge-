# 换行符规范：脚本必须保持各自平台要求的行尾，否则会执行失败
# .sh 在 Linux/macOS 上若为 CRLF 会报 bad interpreter
*.sh  text eol=lf
# PowerShell / 批处理在 Windows 上运行
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资源，不做换行符转换
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
